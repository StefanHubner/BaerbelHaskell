; Telematica service settings and credentials from the private site YAML.
; No sections below replace the existing A&A UDP transport or inbound endpoint.
[phone-assistant-telematica-tcp]
type=transport
protocol=tcp
bind=@@network.sipBind@@
local_net=@@network.localNet@@
external_signaling_address=@@network.publicAddress@@
external_signaling_port=5060
external_media_address=@@network.publicAddress@@
allow_reload=no

[phone-assistant-telematica-auth]
type=auth
auth_type=userpass
username=@@telematica.username@@
password=@@telematica.password@@

[phone-assistant-telematica-registration]
type=registration
transport=phone-assistant-telematica-tcp
outbound_auth=phone-assistant-telematica-auth
server_uri=sip:sip.telematica.at
client_uri=sip:@@telematica.username@@@sip.telematica.at
outbound_proxy=sip:sip.telematica.at\;lr\;hide
contact_user=@@telematica.username@@
retry_interval=60
forbidden_retry_interval=600
expiration=300

[phone-assistant-telematica-aor]
type=aor
contact=sip:sip.telematica.at:5060
qualify_frequency=0

[phone-assistant-telematica]
type=endpoint
transport=phone-assistant-telematica-tcp
context=from-telematica
identify_by=ip
aors=phone-assistant-telematica-aor
outbound_auth=phone-assistant-telematica-auth
outbound_proxy=sip:sip.telematica.at\;lr\;hide
from_user=@@telematica.username@@
from_domain=sip.telematica.at
disallow=all
allow=alaw,ulaw
dtmf_mode=rfc4733
direct_media=no
media_address=@@network.mediaAddress@@
bind_rtp_to_media_address=yes
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
trust_id_inbound=no
trust_id_outbound=no
send_pai=no
send_rpid=no
send_diversion=no
send_history_info=no
send_connected_line=no
allow_subscribe=no
allow_transfer=no
deny=0.0.0.0/0
permit=176.123.55.10/32

[phone-assistant-telematica-identify]
type=identify
endpoint=phone-assistant-telematica
match=176.123.55.10/32

; Reuse the existing authenticated A&A endpoint; no second account/registration.
; Renderer rejects conflicting existing values rather than relying on override order.
[phone-assistant-aa-outbound](+)
send_diversion=no
send_history_info=no
send_rpid=no
send_connected_line=no
allow_transfer=no
