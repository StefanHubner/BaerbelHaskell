; Private incoming A&A authentication; independent of outbound calling.
[phone-assistant-aa-auth]
type=auth
auth_type=userpass
username=@@sharedInbound.username@@
password=@@sharedInbound.password@@

; Shared outbound A&A authentication from the user database.
[phone-assistant-aa-outbound-auth]
type=auth
auth_type=userpass
username=@@SHARED_USER@@
password=@@SHARED_PASSWORD@@

[phone-assistant-aa-outbound-aor]
type=aor
contact=sip:voiceless.aa.net.uk:5060
qualify_frequency=30

[phone-assistant-aa-outbound]
type=endpoint
transport=phone-assistant-udp
context=phone-assistant-outbound-unavailable
identify_by=ip
disallow=all
allow=alaw,ulaw
dtmf_mode=rfc4733
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_address=@@network.mediaAddress@@
bind_rtp_to_media_address=yes
aors=phone-assistant-aa-outbound-aor
outbound_auth=phone-assistant-aa-outbound-auth
from_user=@@SHARED_DIGITS@@
from_domain=voiceless.aa.net.uk
callerid=Phone assistant <@@SHARED_DIGITS@@>
send_pai=yes
send_rpid=no
trust_id_inbound=no
trust_id_outbound=no
allow_transfer=no
allow_subscribe=no

[phone-assistant-home-auth]
type=auth
auth_type=userpass
username=phone-assistant-home
password=@@handset.password@@

[phone-assistant-home]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

[phone-assistant-home]
type=endpoint
transport=phone-assistant-udp
context=phone-assistant-home-inbound
identify_by=username
auth=phone-assistant-home-auth
aors=phone-assistant-home
disallow=all
allow=alaw,ulaw
dtmf_mode=rfc4733
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_address=@@network.mediaAddress@@
bind_rtp_to_media_address=yes
trust_id_inbound=no
trust_id_outbound=no
send_pai=no
send_rpid=no
send_diversion=no
send_history_info=no
allow_transfer=no
allow_subscribe=no
deny=0.0.0.0/0.0.0.0
permit=@@handset.permit@@
contact_deny=0.0.0.0/0.0.0.0
contact_permit=@@handset.permit@@
