digraph Baerbel {
  graph [layout=neato, overlap=true, splines=polyline, bgcolor="#ffffff", pad="0.35", outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=15, margin="0.18,0.15", color="#728397", fillcolor="#eef4fa", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=12, color="#586f86", arrowsize=0.8];
  title [shape=plain, style="", label="BÄRBEL · HASKELL IMPLEMENTATION", fontsize=26, pos="900,1010!"];
  status [shape=plain, style="", label="Haskell service active · Asterisk retained\nProvider/synthetic checks passed · real-call verification pending", fontsize=15, pos="900,965!"];
  phones [label="Owner / public callers\nSIP providers and home phone", pos="900,870!", width=4.7];
  pbx [label="Existing Asterisk\nNative channel ownership, dialplan, bridge\nAudioSocket · AMI · FastAGI · full-call WAV", pos="900,750!", width=5.9, fillcolor="#eaf2ed", color="#618d73"];
  owner [label="Owner ingress :9092\nSeparate managed-media registry\nPIN gate for private email tools", pos="420,570!", width=5.2, fillcolor="#f1eaf8", color="#9674b2"];
  public [label="Public ingress :9093\nSeparate registry and restricted session\nScreen / decline / take message only", pos="1380,570!", width=5.2, fillcolor="#fff1e5", color="#b98b65"];
  shell [label="Imperative Shell · Baerbel.Runtime.*\nEffects, capabilities and resource lifetimes\nHTTP / WebSocket / AMI · audio / files / SQLite\nWorkers stop → Live close/ack → final log", pos="900,340!", width=6.5, height=1.35, fillcolor="#eaf2ed", color="#618d73", penwidth=2.0];
  core [label="Functional Core · Baerbel.Core.*\nImmutable values, parsing and decisions\nPhone validation · routes · transitions\nRequests · results · no IO", pos="1650,340!", width=5.6, height=1.35, fillcolor="#ffffff", color="#527fa5", penwidth=2.0];
  speech [label="Speech providers\nLive WebSocket\nLegacy STT → chat → TTS", pos="180,340!", width=3.6];
  providers [label="Owner tools and caller lookup\nGmail · Calendar · Contacts\nMaps · Windguru · shared profile store", pos="420,100!", width=5.2];
  notifications [label="Fixed-recipient notifications\nSMS and owner voice notes\nAccepted delivery survives hangup", pos="1380,100!", width=5.2, fillcolor="#fff1e5"];
  state [label="Durable external state\nGmail/Calendar/SMS receipts · PBX event cursor\nPrivate profile · existing call archive", pos="900,-120!", width=6.7, fillcolor="#f3f4f6"];
  config [label="Configuration files\nGlobal rules, schemas + phone metadata\nOne private user settings file", pos="1830,570!", width=3.8, fillcolor="#f3f4f6"];
  permissions [shape=plain, style="", label="Owner ingress retains the Asterisk trust boundary; public input never grants owner tools\nReserve before side effects; preserve uncertain outcomes without automatic replay", fontsize=14, pos="900,-235!"];
  legend [shape=plain, style="", label="Solid arrows: call / data flow · dashed arrow: module imports (Runtime → Core only)", fontsize=14, pos="900,-290!"];
  phones -> pbx [label="calls"];
  pbx -> owner [label="authorized owner leg"];
  pbx -> public [label="untrusted caller leg"];
  pbx -> shell [label="home FastAGI :4573\nfixed destination policy"];
  owner -> shell;
  public -> shell;
  shell -> core [style=dashed, label="imports", color="#527fa5", penwidth=1.8];
  shell -> speech [dir=both, label="audio / events"];
  shell -> providers [dir=both, label="scoped capabilities"];
  shell -> notifications [label="fixed-recipient delivery"];
  shell -> state [dir=both, label="state / receipts"];
  config -> shell [label="load and validate"];
}
